xelMode.RGB)\nstrip.set_brightness(100)\nradio.set_group(1)\nfaces.show_face(faces.Eyes.MAD, faces.Mouth.SMIRK)\n# Wheels are on P0 and P2\nBitBuggy.init_wheel(AnalogPin.P0, AnalogPin.P2)\n# Set the grabber to its starting position on P1\nservos.P1.set_angle(90)\n\ndef on_forever():\n    faces.blink(2000, 50, 200)\nbasic.forever(on_forever)\n\ndef on_forever2():\n    if randint(1, 10) == 1:\n        faces.wink(Math.random_boolean(), 1000, Math.random_boolean())\n    elif randint(1, 10) == 2:\n        faces.wink(Math.random_boolean(), 1000, Math.random_boolean())\nbasic.forever(on_forever2)\n"}]},{"timestamp":1778701739099,"editorVersion":"8.0.22","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":51,"diffs":[[1,"radio.onReceivedString(function on_received_string(receivedString: string) {\n"]]},{"start1":478,"length1":63,"diffs":[[1,"        //  Opens the grabber (Make sure it's plugged into P1!)\n"]]},{"start1":613,"length1":79,"diffs":[[1,"        //  Closes the grabber (You will need to send \"C\" from your controller)\n"]]},{"start1":765,"length1":30,"diffs":[[1,"        //  Flashes the lights\n"]]},{"start1":1111,"length1":0,"diffs":[[1,"    \n"]]},{"start1":1119,"length1":33,"diffs":[[1,"let strip : neopixel.Strip = null\n"]]},{"start1":1320,"length1":27,"diffs":[[1,"//  Wheels are on P0 and P2\n"]]},{"start1":1396,"length1":50,"diffs":[[1,"//  Set the grabber to its starting position on P1\n"]]},{"start1":1470,"length1":28,"diffs":[[1,"basic.forever(function on_forever() {\n"]]},{"start1":1542,"length1":28,"diffs":[[1,"basic.forever(function on_forever2() {\n"]]},{"start1":1794,"length1":0,"diffs":[[1,"    \n"]]}]}]},{"timestamp":1778701765433,"editorVersion":"8.0.22","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":11571,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"{=iCvzC8!-^vnCjYqtn@\">strip</variable><variable id=\"n]HsTaG.;T[9~4IlX(v]\">imag<